# Supabase (get from supabase.com dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # only in Vercel env, never NEXT_PUBLIC_

# Admin allowlist (comma separated emails you will use for Supabase Auth login)
ADMIN_EMAILS=you@example.com

# Email tickets (optional but recommended — resend.com → API Keys)
RESEND_API_KEY=re_...
TICKET_FROM_EMAIL=Sandhya Cine House <tickets@yourdomain.com>
